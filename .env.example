# Copy this file to .env and fill in what you need. .env is gitignored.
# Nothing here is required to run the dashboard — these only enable the AI features.

# --- AI chat via Groq ---
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# --- AI via Gemini ---
# Use this exact spelling: environment variable names are case-sensitive on
# Linux/macOS, so a differently-cased name only works on Windows.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# --- Optional ---
# Cap on AI reply length in tokens (default 450)
# AI_MAX_TOKENS=450
# Set to 1 for auto-reload while developing
# PLANTPULSE_DEV=
